rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      // Allow reading if the user is signed in
      allow read: if request.auth != null;
      // Allow writing only if the user is signed in AND matches the document ID
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    // Allow access to chats only if the user is a participant
    match /chats/{chatId} {
      // Create is allowed by authenticated users, our code sets participants.
      allow create: if request.auth != null;
      // Read & update only permitted if the user is in the participants array.
      allow read, update: if request.auth != null && request.auth.uid in resource.data.participants;
      allow delete: if request.auth != null && request.auth.uid in resource.data.participants;
      
      match /messages/{messageId} {
        // Enforce that the user is a participant in the parent chat
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        // Enforce the sender matches the payload AND the sender belongs to the chat room
        allow write: if request.auth != null 
                     && request.auth.uid == request.resource.data.senderId 
                     && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // Feedback collection
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
    }
  }
}
